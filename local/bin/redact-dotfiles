#!/usr/bin/env bash
#
# git clean/smudge filter swapping secrets for placeholders.
#
# The substitution table lives outside this repository, one "KEY|value" pair
# per line. An empty table is a legitimate state: it means this machine holds
# no credentials, and content then passes through untouched.
#
# A missing table is an error rather than an empty one, because passing content
# through on a machine that does have secrets would commit them in clear.
#
# Substitution is literal, which is the whole point of the parameter expansion
# below. This used to build a sed program by string interpolation and eval it,
# so every secret was parsed twice: once as shell tokens, once as a regular
# expression. A value containing a quote or a '#' aborted the filter loudly,
# but one containing '\', '*' or '[' matched nothing, exited 0, and let git
# commit the secret in clear. filter.secrets.required does not catch that:
# from git's point of view the filter succeeded.
#
# Nothing here is a pattern any more. Both sides of "${content//"$from"/"$to"}"
# are quoted, which is precisely what makes bash match and insert them
# verbatim rather than as a glob and an escape sequence.
#
# Text only. bash cannot hold a NUL byte, so a binary file would come out
# mangled. Every tracked file in both repositories is text, and binaries live
# in ~/bin outside them.

set -o errexit
set -o pipefail
set -o nounset

DB="${HOME}/.local/state/dotfiles/db.txt";

action="${1:?"action must be either redact or reveal"}";

case "${action}" in
  redact|reveal) ;;
  *)
    echo "invalid action \"${action}\". action must be either redact or reveal" >&2;
    exit 1;
    ;;
esac

if [ ! -f "${DB}" ]; then
  echo "no substitution table at ${DB}." >&2;
  echo "restore it from the password manager, or create it empty if this machine holds no secrets." >&2;
  exit 1;
fi

# "$( )" strips every trailing newline from what it captures, so a file ending
# in a blank line would come back one byte shorter and the filter would rewrite
# it on every checkout.
#
# Appending an "x" inside the substitution puts a non-newline byte last, so
# there is nothing left at the end for the stripping to take, and the newlines
# in front of it survive. The next line takes the "x" back off. printf rather
# than echo precisely because printf adds no newline of its own; one here would
# be stripped and the guard would achieve nothing.
content="$(cat; printf 'x')";
content="${content%x}";

# The table has to be newline-terminated: read does not return a final line
# without one, and that entry would simply stop being substituted.
while IFS= read -r line; do
  # tolerate blank lines and comments
  [ -n "${line}" ] || continue;
  case "${line}" in \#*) continue;; esac;

  # split on the first separator only, so a value may contain one
  key="${line%%|*}";
  value="${line#*|}";

  [ -n "${key}" ] && [ -n "${value}" ] || continue;

  case "${action}" in
    redact) content="${content//"${value}"/"${key}"}";;
    reveal) content="${content//"${key}"/"${value}"}";;
  esac
done < "${DB}"

printf '%s' "${content}";
