DOTFILES_DIRS="${HOME}/Workspaces/github.com/kdisneur/dotfiles";

# Everything that cannot be derived from the machine itself lives in an
# untracked ~/.rcrc.local, e.g. at work:
#   LOCATION="work";
#   DOTFILES_DIRS="${DOTFILES_DIRS} ${HOME}/path/to/work-dotfiles";
#   EXTRA_TAGS="shared-tag";
LOCATION="home";
if [ -r "${HOME}/.rcrc.local" ]; then
  . "${HOME}/.rcrc.local";
fi

case "$(uname -s)" in
  Darwin) OS="macos";;
  Linux)  OS="linux";;
esac

TAGS="${OS} ${LOCATION} ${EXTRA_TAGS:-}";

EXCLUDES="README.md etc";
